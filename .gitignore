# CampusFix - Git Ignore
# Exclude PHP session files, logs, local config, and OS clutter

# PHP Sessions
/tmp/
*.session

# PHP Error Logs
*.log
error_log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# IDE / Editor folders
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Environment / secrets (if added later)
.env
.env.local
.env.production

# Composer dependencies are installed from the tracked lock file.
/vendor/
